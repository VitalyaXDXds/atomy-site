*{box-sizing:border-box}body{margin:0;color:#1c2a40;background:#fff;font:17px/1.75 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding-top:env(safe-area-inset-top,0)}
body:before,body:after{content:"";position:fixed;z-index:-1;pointer-events:none;mix-blend-mode:multiply;background-size:100% 100%;width:min(40vw,340px)}
body:before{top:0;left:0;aspect-ratio:360/300;background-image:url(./sakura-tl.jpg)}
body:after{bottom:0;right:0;aspect-ratio:450/320;background-image:url(./sakura-br.jpg);width:min(46vw,400px)}
.w{max-width:760px;margin:0 auto;padding:0 20px}header{border-bottom:1px solid rgba(40,120,210,.18);background:rgba(255,255,255,.85);backdrop-filter:blur(12px)}
header .w{display:flex;gap:18px;align-items:center;height:58px;flex-wrap:wrap}header b{font-family:Georgia,serif;margin-right:auto}a{color:#0d5fb8}header a{color:#1c2a40;text-decoration:none;font-size:14px}
h1,h2{font-family:Georgia,serif;line-height:1.25;color:#1c2a40}h1{font-size:clamp(28px,6vw,42px);margin:40px 0 8px}h2{font-size:24px;margin:34px 0 10px}p,li{color:#566883}.m{font-size:14px;color:#7a8aa3}
.card{display:block;background:rgba(255,255,255,.8);border:1px solid rgba(40,120,210,.18);border-radius:20px;padding:20px 22px;margin:14px 0;text-decoration:none;box-shadow:0 8px 24px rgba(30,100,200,.08)}.card h2{margin:0 0 6px;font-size:21px;color:#1c2a40}.card p{margin:0}
.cta{background:rgba(255,255,255,.85);border:1px solid rgba(40,120,210,.18);border-radius:22px;padding:24px;margin:40px 0;text-align:center;box-shadow:0 10px 30px rgba(30,100,200,.1)}
.btn{display:inline-block;background:linear-gradient(135deg,#42a5f5,#1565c0);color:#fff;border:0;border-radius:999px;padding:13px 26px;font:600 16px inherit;text-decoration:none;cursor:pointer}
.note{border-left:3px solid #f4a6c0;padding:4px 16px;background:rgba(255,240,246,.6);border-radius:0 12px 12px 0}
footer{padding:30px 0 50px;font-size:13px;color:#7a8aa3;text-align:center}
